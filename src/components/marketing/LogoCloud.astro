---
/**
 * LogoCloud.astro — Social Proof component
 *
 * Displays a row of customer/partner logos.
 * Great for building trust on B2B SaaS landing pages.
 */

interface Logo {
  name: string;
  src: string;
  darkSrc?: string;
  className?: string;
}

interface Props {
  title?: string;
  logos: Logo[];
}

const { title = 'Trusted by innovative teams worldwide', logos } = Astro.props;
---

<section class="border-t border-[var(--border)] bg-[var(--bg-secondary)]/50 py-12 md:py-16">
  <div class="mx-auto max-w-7xl px-6 text-center">
    <p class="text-sm font-semibold tracking-wide text-[var(--text-tertiary)] uppercase">{title}</p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-x-12 gap-y-8 opacity-80 transition-all hover:opacity-100 sm:gap-x-16">
      {logos.map((logo) => (
        <>
          <img
            src={logo.src}
            alt={`${logo.name} logo`}
            loading="lazy"
            width="120"
            height="40"
            class={`h-8 w-auto max-w-[120px] object-contain sm:h-10 drop-shadow-[0_0_20px_rgba(0,0,0,0.5)] dark:drop-shadow-[0_0_20px_rgba(255,255,255,0.6)] ${logo.darkSrc ? 'dark:hidden' : ''} ${logo.className || ''}`}
          />
          {logo.darkSrc && (
            <img
              src={logo.darkSrc}
              alt={`${logo.name} logo (dark)`}
              loading="lazy"
              width="120"
              height="40"
              class={`hidden h-8 w-auto max-w-[120px] object-contain sm:h-10 drop-shadow-[0_0_20px_rgba(0,0,0,0.5)] dark:drop-shadow-[0_0_20px_rgba(255,255,255,0.6)] dark:block ${logo.className || ''}`}
            />
          )}
        </>
      ))}
    </div>
  </div>
</section>
