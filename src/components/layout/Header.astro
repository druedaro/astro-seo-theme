---
/**
 * Header.astro — Site header with navigation and dark mode toggle
 *
 * Features:
 * - Sticky header with backdrop blur
 * - Responsive nav (mobile hamburger menu)
 * - Dark mode toggle (React Island)
 * - Active link highlighting
 */
import DarkModeToggle from '../ui/DarkModeToggle.tsx';

const navLinks = [
  { label: 'Features', href: '/#features' },
  { label: 'Pricing', href: '/pricing' },
  { label: 'Blog', href: '/blog' },
  { label: 'Case Studies', href: '/case-studies' },
  { label: 'About', href: '/about' },
];

const currentPath = Astro.url.pathname;
---

<header
  class="sticky top-0 z-50 w-full border-b border-[var(--border)] bg-[var(--bg)]/80 backdrop-blur-lg"
>
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-6">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2.5 font-display text-lg font-bold tracking-tight">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-7 w-7 text-[var(--color-primary-500)]"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" />
      </svg>
      <span>Astro<span class="text-[var(--color-primary-500)]">SEO</span></span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden items-center gap-1 md:flex" aria-label="Main navigation">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class:list={[
            'rounded-lg px-3 py-2 text-sm font-medium transition-colors',
            currentPath === link.href || currentPath.startsWith(link.href + '/')
              ? 'text-[var(--text-primary)] bg-[var(--bg-secondary)]'
              : 'text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-secondary)]',
          ]}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <!-- Right side: CTA + Dark mode -->
    <div class="flex items-center gap-3">
      <DarkModeToggle client:load />
      <a
        href="https://github.com/druedaro/astro-seo-theme"
        target="_blank"
        rel="noopener noreferrer"
        class="hidden rounded-lg bg-[var(--color-primary-500)] px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-[var(--color-primary-600)] sm:inline-flex"
      >
        GitHub
      </a>

      <!-- Mobile menu button -->
      <button
        id="mobile-menu-btn"
        class="flex h-9 w-9 items-center justify-center rounded-lg text-[var(--text-secondary)] transition-colors hover:bg-[var(--bg-secondary)] md:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Navigation -->
  <nav
    id="mobile-menu"
    class="hidden border-t border-[var(--border)] px-6 py-4 md:hidden"
    aria-label="Mobile navigation"
  >
    <div class="flex flex-col gap-1">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class:list={[
            'rounded-lg px-3 py-2.5 text-sm font-medium transition-colors',
            currentPath === link.href || currentPath.startsWith(link.href + '/')
              ? 'text-[var(--text-primary)] bg-[var(--bg-secondary)]'
              : 'text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-secondary)]',
          ]}
        >
          {link.label}
        </a>
      ))}
    </div>
  </nav>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(isOpen));
  });
</script>
