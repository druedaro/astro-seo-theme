---
/**
 * Footer.astro — Site footer with navigation columns and social links
 */

const currentYear = new Date().getFullYear();

const footerColumns = [
  {
    title: 'Product',
    links: [
      { label: 'Features', href: '/#features' },
      { label: 'Pricing', href: '/pricing' },
      { label: 'Case Studies', href: '/case-studies' },
    ],
  },
  {
    title: 'Resources',
    links: [
      { label: 'Blog', href: '/blog' },
      { label: 'Documentation', href: '/docs' },
      { label: 'RSS Feed', href: '/rss.xml' },
    ],
  },
  {
    title: 'Company',
    links: [
      { label: 'About', href: '/about' },
      { label: 'GitHub', href: 'https://github.com/druedaro/astro-seo-theme' },
      { label: 'License (MIT)', href: '/LICENSE' },
    ],
  },
];
---

<footer class="border-t border-[var(--border)] bg-[var(--bg)]">
  <div class="mx-auto max-w-7xl px-6 py-12 md:py-16">
    <div class="grid grid-cols-2 gap-8 md:grid-cols-4">
      <!-- Brand column -->
      <div class="col-span-2 md:col-span-1">
        <a href="/" class="flex items-center gap-2 font-display text-lg font-bold">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-6 w-6 text-[var(--color-primary-500)]"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" />
          </svg>
          Astro<span class="text-[var(--color-primary-500)]">SEO</span>
        </a>
        <p class="mt-3 text-sm leading-relaxed text-[var(--text-secondary)]">
          The ultimate open-source Astro theme for B2B/SaaS marketing websites with advanced SEO.
        </p>
      </div>

      <!-- Navigation columns -->
      {footerColumns.map((column) => (
        <div>
          <h3 class="text-sm font-semibold text-[var(--text-primary)]">{column.title}</h3>
          <ul class="mt-3 space-y-2.5">
            {column.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-sm text-[var(--text-tertiary)] transition-colors hover:text-[var(--text-primary)]"
                  {...(link.href.startsWith('http') && {
                    target: '_blank',
                    rel: 'noopener noreferrer',
                  })}
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- Bottom bar -->
    <div class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-[var(--border)] pt-8 text-sm text-[var(--text-tertiary)] md:flex-row">
      <p>&copy; {currentYear} Astro SEO Theme. Open source under MIT License.</p>
      <p>
        Built with{' '}
        <a href="https://astro.build" class="font-medium text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors" target="_blank" rel="noopener noreferrer">
          Astro
        </a>
      </p>
    </div>
  </div>
</footer>
