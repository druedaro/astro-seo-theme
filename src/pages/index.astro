---
import BaseLayout from '../layouts/BaseLayout.astro';
import JsonLd from '../components/seo/JsonLd.astro';

const siteUrl = Astro.site?.toString() ?? 'https://astro-seo-theme.vercel.app';
---

<BaseLayout
  title="The Ultimate B2B/SaaS Marketing Theme"
  description="Open-source Astro theme with advanced SEO, GEO & AEO optimization. Built for SaaS companies and B2B marketing websites. Lighthouse 100/100."
>
  <Fragment slot="head">
    <JsonLd
      type="WebSite"
      data={{
        name: 'Astro SEO Theme',
        url: siteUrl,
        description: 'The ultimate open-source Astro theme for B2B/SaaS marketing websites.',
        searchUrl: `${siteUrl}/search`,
      }}
    />
    <JsonLd
      type="Organization"
      data={{
        name: 'Astro SEO Theme',
        url: siteUrl,
        description: 'Open-source Astro theme with advanced SEO optimization for B2B and SaaS websites.',
      }}
    />
  </Fragment>
  <section class="flex min-h-[80vh] flex-col items-center justify-center px-6 text-center">
    <p class="mb-4 text-sm font-medium uppercase tracking-widest text-[var(--text-tertiary)]">
      Open Source · SEO-First · B2B Ready
    </p>
    <h1 class="mx-auto max-w-4xl text-5xl font-extrabold leading-tight tracking-tight md:text-7xl">
      The SEO Theme
      <span class="bg-gradient-to-r from-[var(--color-primary-400)] to-[var(--color-accent-400)] bg-clip-text text-transparent">
        Your SaaS Deserves
      </span>
    </h1>
    <p class="mx-auto mt-6 max-w-2xl text-lg text-[var(--text-secondary)] md:text-xl">
      Advanced technical SEO, GEO &amp; AEO optimization out of the box.
      Lighthouse 100/100. Dark mode. i18n. Built with Astro, Tailwind &amp; React.
    </p>
    <div class="mt-10 flex flex-col gap-4 sm:flex-row">
      <a
        href="https://github.com/druedaro/astro-seo-theme"
        class="inline-flex items-center gap-2 rounded-xl bg-[var(--color-primary-500)] px-8 py-3.5 text-sm font-semibold text-white shadow-lg shadow-[var(--color-primary-500)]/25 transition-all hover:bg-[var(--color-primary-600)] hover:shadow-xl"
      >
        Get Started
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
        </svg>
      </a>
      <a
        href="/blog"
        class="inline-flex items-center gap-2 rounded-xl border border-[var(--border)] px-8 py-3.5 text-sm font-semibold text-[var(--text-primary)] transition-all hover:border-[var(--border-hover)] hover:bg-[var(--bg-secondary)]"
      >
        Read the Blog
      </a>
    </div>
  </section>
</BaseLayout>
